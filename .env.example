# Copy to .env (never commit .env). Real secrets live in the encrypted vault,
# this file only holds non-secret settings and vault references.

ACHORDS_WEB_PORT=3420
ACHORDS_BIND=127.0.0.1

# Frontier provider mode: cli | api
ACHORDS_PROVIDER_MODE=cli

# Local model runtime (OpenAI-compatible endpoint)
ACHORDS_LOCAL_LLM_URL=http://127.0.0.1:11434/v1

# Telegram bot token is stored in the vault, referenced here:
TELEGRAM_BOT_TOKEN=vault:telegram-boss
